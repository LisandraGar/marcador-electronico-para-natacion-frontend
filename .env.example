# Configuración de conexión MQTT WebSocket (WSS)
# Modifique estos valores con los datos de su cluster (por ejemplo en HiveMQ Cloud)

# Host del broker MQTT (sin wss:// ni protocolo)
VITE_BROKER_URL=tu-broker.hivemq.cloud

# Puerto WebSocket Seguro (WSS) en HiveMQ suele ser 8884
VITE_WS_BROKER_PORT=8884

# Credenciales de acceso MQTT
VITE_MQTT_USERNAME=usuario_marcador
VITE_MQTT_PASSWORD=password_seguro
